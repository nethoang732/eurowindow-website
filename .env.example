# Server-only credentials. Never prefix these names with NEXT_PUBLIC_.
# Server only. Prefer the Secret API key (sb_secret_...) from Supabase > Project Settings > API Keys.
# A legacy service_role JWT is also accepted. Never use anon/publishable here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional email notification via the existing Google Apps Script integration.
# Supabase is the primary data store; mail failures do not undo a saved lead.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_SECRET=generate-a-random-secret-with-at-least-32-bytes

# Optional comma-separated origins allowed to submit from a different host.
# GitHub Pages origin is already allowed for the static mirror.
CONTACT_ALLOWED_ORIGINS=

# Public API URL used only by the static GitHub Pages build. It is not a secret.
NEXT_PUBLIC_CONTACT_API_URL=https://eurowindow-website.vercel.app/api/contact
